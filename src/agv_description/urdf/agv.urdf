<?xml version="1.0"?>
<robot name="agv">

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.40" length="0.20"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
  </link>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

</robot>rsion="1.0"?>
<robot name="agv">

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
  </link>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

</robot>
